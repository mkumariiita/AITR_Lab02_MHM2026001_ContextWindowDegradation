# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env or paste keys into chat / GitHub.

# Which backend to prefer when config says openai_compat
LLM_BACKEND=openai_compat

# --- Option 1: Groq (recommended free) ---
LLM_API_KEY=gsk_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- Option 2: Google Gemini (uncomment + replace Option 1) ---
# LLM_API_KEY=AIza_your_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Option 3: OpenRouter free model (uncomment + replace Option 1) ---
# LLM_API_KEY=sk-or-your_key_here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Option 4: DeepSeek (only if you have free/gift credit) ---
# LLM_API_KEY=your_deepseek_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash